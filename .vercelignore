# Patterns here match at ANY depth unless anchored with a leading slash.
# An unanchored "site*" also matches src/site.ts, which silently dropped source
# files from the upload and made the build fail with "cannot find module".
node_modules
.git

# Export output, at the repo root only.
/out
/out-*
/site
/generic-test
/nd*
/*.zip
/verify-diffs
/verify-*

# Not needed to build or run the function.
/test
/.github
