{
  "name": "unframer",
  "version": "0.1.0",
  "description": "Convert a published Framer site into portable, framework-free HTML, CSS and JavaScript you can host anywhere",
  "keywords": [
    "framer",
    "framer-export",
    "static-site",
    "html-export",
    "no-code",
    "self-hosting",
    "site-converter"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "unframer": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Niranjan266/unframer.git"
  },
  "bugs": {
    "url": "https://github.com/Niranjan266/unframer/issues"
  },
  "homepage": "https://github.com/Niranjan266/unframer#readme",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "serve": "tsx src/cli.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "cheerio": "^1.0.0",
    "postcss": "^8.4.47"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.7.5",
    "@types/pngjs": "^6.0.5",
    "html-validate": "^11.9.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
